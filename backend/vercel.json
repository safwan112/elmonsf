{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../frontend && npm ci",
  "buildCommand": "cd ../frontend && npm run build && rm -rf ../backend/dist && cp -r dist ../backend/dist",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 30,
      "excludeFiles": "{tests/**,storage/logs/**,storage/framework/**,node_modules/**,dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.php" },
    { "source": "/sanctum/:path*", "destination": "/api/index.php" },
    { "source": "/__myfatoorah-sim/:path*", "destination": "/api/index.php" },
    { "source": "/sitemap.xml", "destination": "/api/index.php" },
    { "source": "/up", "destination": "/api/index.php" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 3 * * *" }]
}
