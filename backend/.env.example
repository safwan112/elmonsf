APP_NAME="ذروة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Public URL of the React SPA (used for CORS, Sanctum, emails and payment redirects)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
# Store and process times in UTC; the SPA formats them for Asia/Riyadh.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

# Comma separated reverse-proxy IPs/CIDRs (or "*" behind a managed load balancer)
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elmonsf
DB_USERNAME=elmonsf
DB_PASSWORD=
# The test suite uses a separate database named "elmonsf_test" (see phpunit.xml),
# with the same host/credentials as above.

# --- Session / Sanctum SPA authentication (cookie based) ---
# The SPA and the API must share a registrable domain in production,
# e.g. app.example.com + api.example.com with SESSION_DOMAIN=.example.com
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Login/register brute-force limits (attempts per minute)
AUTH_THROTTLE_PER_MINUTE=5
AUTH_THROTTLE_IP_PER_MINUTE=20
# Max auth emails (reset links, sign-in codes, verification) per address per hour
AUTH_EMAILS_PER_HOUR=6
# Contact form / newsletter submissions per IP per hour
CONTACT_PER_HOUR=10
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:4173,127.0.0.1:4173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: Bunny Stream library id for lesson videos
BUNNY_STREAM_LIBRARY_ID=

# --- MyFatoorah (API v3) — server side only, NEVER expose to the SPA ---
# Sandbox base URL: https://apitest.myfatoorah.com
# Saudi Arabia live base URL: https://api-sa.myfatoorah.com
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_WEBHOOK_SECRET=
MYFATOORAH_CURRENCY=SAR
MYFATOORAH_PAYMENT_METHOD=CARD
MYFATOORAH_TIMEOUT=20
# Public URL MyFatoorah sends the customer back to. Defaults to this API's
# /api/v1/payments/myfatoorah/callback route.
MYFATOORAH_CALLBACK_URL=
# Local sandbox simulator at /__myfatoorah-sim (never works in production).
# Set MYFATOORAH_BASE_URL=http://127.0.0.1:8000/__myfatoorah-sim and any
# API key / webhook secret to pay offline.
MYFATOORAH_SIMULATOR=false

# --- Store ---
STORE_CURRENCY=SAR
# Prices are VAT inclusive; the invoice shows the VAT portion.
VAT_RATE=15
# Unpaid orders are cancelled after this many hours (orders:cancel-stale).
PENDING_ORDER_TTL_HOURS=24
# A started payment link is reused for this long instead of creating a new one.
PAYMENT_LINK_TTL_MINUTES=30

# --- Seed accounts (local/demo only; seeding default passwords is refused in production) ---
SEED_ADMIN_NAME="مدير المنصة"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
