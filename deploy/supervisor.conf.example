# /etc/supervisor/conf.d/elmonsf-worker.conf
# Queue worker: emails, announcements (SendBroadcast), notifications.
# After each deploy run `php artisan queue:restart` so workers load new code.

[program:elmonsf-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/elmonsf/backend/artisan queue:work --sleep=3 --tries=3 --max-time=3600
directory=/var/www/elmonsf/backend
user=www-data
numprocs=2
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=3600
redirect_stderr=true
stdout_logfile=/var/www/elmonsf/backend/storage/logs/worker.log
