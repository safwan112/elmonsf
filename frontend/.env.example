# Base URL of the Laravel API origin (no trailing slash, without /api/v1).
# Leave empty in development: Vite proxies /api and /sanctum to VITE_DEV_API_PROXY,
# which keeps the SPA and API on one origin for Sanctum cookies.
# In production set it to the API origin, e.g. https://api.example.com
VITE_API_URL=

# Where the Vite dev/preview proxy forwards /api and /sanctum.
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Public name and canonical origin of the site (used for SEO tags).
VITE_APP_NAME=ذروة
VITE_SITE_URL=http://localhost:5173

# NOTE: Never put secrets here. Everything prefixed with VITE_ is shipped to the browser.
# Payment gateway keys (MyFatoorah) live only in the Laravel backend .env.
